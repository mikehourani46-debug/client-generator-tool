# ── Claude / Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_api_key_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Lead Provider ─────────────────────────────────────────────────────────────
# Controls which data source powers the "Find Leads" search (Step 0).
#
# Options:
#   mock          — Demo data, no API key needed (default)
#   google_places — Google Places API (requires GOOGLE_PLACES_API_KEY)
#   serpapi       — SerpAPI Google Maps  (requires SERPAPI_KEY)
#   outscraper    — Outscraper API       (requires OUTSCRAPER_API_KEY)
#   apify         — Apify scraper        (requires APIFY_TOKEN)
#
# To add a new provider: extend providers/LeadProvider.js and register it
# in providers/index.js, then set LEAD_PROVIDER to the new name.
LEAD_PROVIDER=mock

# ── Google Places API (if LEAD_PROVIDER=google_places) ───────────────────────
GOOGLE_PLACES_API_KEY=

# ── SerpAPI (if LEAD_PROVIDER=serpapi) ────────────────────────────────────────
SERPAPI_KEY=

# ── Outscraper (if LEAD_PROVIDER=outscraper) ─────────────────────────────────
OUTSCRAPER_API_KEY=

# ── Apify (if LEAD_PROVIDER=apify) ───────────────────────────────────────────
APIFY_TOKEN=
